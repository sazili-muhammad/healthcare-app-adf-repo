{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-healthcare-app"
		},
		"ls_adls_healthcare_app_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagehealthcareapp.dfs.core.windows.net/"
		},
		"ls_azure_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "healthcare-sql-db-server.database.windows.net"
		},
		"ls_azure_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-healthcare-app"
		},
		"ls_azure_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "healthcare_admin"
		},
		"ls_azuredatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1022-122548-hsxmq5js"
		},
		"ls_kv_healthcare_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-healthcare-app.vault.azure.net/"
		},
		"ls_postgre_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-patient-shadow-azvt2sc7-pooler.c-3.ap-southeast-1.aws.neon.tech"
		},
		"ls_postgre_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgre_sql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-healthcare-app_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_healthcare_app_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_healthcare_app_properties_typeProperties_url')]"
					},
					"ls_kv_healthcare_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_kv_healthcare_properties_typeProperties_baseUrl')]"
					},
					"ls_azure_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_azure_sql_properties_typeProperties_server')]"
					},
					"ls_azure_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_azure_sql_properties_typeProperties_database')]"
					},
					"ls_azure_sql_properties_typeProperties_userName": {
						"value": "[parameters('ls_azure_sql_properties_typeProperties_userName')]"
					},
					"ls_azuredatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_azuredatabricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_postgre_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_postgre_sql_properties_typeProperties_server')]"
					},
					"ls_postgre_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_postgre_sql_properties_typeProperties_database')]"
					},
					"ls_postgre_sql_properties_typeProperties_username": {
						"value": "[parameters('ls_postgre_sql_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}